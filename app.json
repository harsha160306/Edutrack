{
  "expo": {
    "name": "MICFacultyApp",
    "slug": "MICFacultyApp",
    "version": "1.0.0",
    "extra": {
      "buildNumber": "20260503.1",
      "apiBaseUrl": "http://127.0.0.1:8000/api/v1"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MIC Faculty to unlock the app with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MIC Faculty to scan student ID cards.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
