{
  "name": "micfacultyapp",
  "version": "1.0.0",
  "description": "MIC EduTrack mobile app",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node scripts/run-with-safe-path.mjs npx expo start",
    "prestart:lan": "node scripts/free-metro-port.mjs",
    "start:lan": "node scripts/run-with-safe-path.mjs npx expo start --lan --clear",
    "start:device": "node scripts/run-with-safe-path.mjs npx expo start --lan --clear",
    "prestart:tunnel": "node scripts/free-metro-port.mjs",
    "start:tunnel": "node scripts/start-tunnel.mjs",
    "prestart:localhost": "node scripts/adb-reverse-all.mjs",
    "start:localhost": "node scripts/run-with-safe-path.mjs npx expo start --localhost --clear",
    "android": "node scripts/run-with-safe-path.mjs npx expo start --android",
    "android:device": "npm run start:device",
    "android:usb": "node scripts/android-dev.mjs",
    "adb:reverse": "node scripts/adb-reverse-all.mjs",
    "ios": "node scripts/run-with-safe-path.mjs npx expo start --ios",
    "web": "node scripts/start-web.mjs",
    "postinstall": "node scripts/patch-onedrive-metro.js"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.7.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
